# ML artifacts
mlruns/
mlartifacts/
*.pkl
*.joblib
*.pt
*.onnx
# Anchored to repo root so we don't accidentally ignore `src/models/`
# (the source tree for model classes). Future trained-model dumps go in /models/.
/models/

# DVC: ignore the data dirs' contents but keep the DVC pointer files
# and the per-directory .gitignore files that `dvc add` manages.
# Without the un-ignores, the blanket /data/raw/ pattern would hide the
# very .dvc refs git needs to track.
/data/raw/*
/data/processed/*
!/data/raw/.gitignore
!/data/raw/*.dvc
!/data/processed/.gitignore
!/data/processed/*.dvc
# The TMDB snapshot is one directory per pull date, so its pointer files sit a
# level deeper than the flat `ml-25m.dvc` and the un-ignores above cannot reach
# them: git will not re-include anything under a directory it has already
# excluded. Re-include the directory itself, then ignore its contents and keep
# the pointers, so each dated snapshot is versioned on its own.
!/data/raw/tmdb/
/data/raw/tmdb/*
!/data/raw/tmdb/.gitignore
!/data/raw/tmdb/*.dvc
.dvc/cache/
.dvc/tmp/

# Env / secrets
.env
.env.*
*.env
!.env.example

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Local agent scratch, including the git worktrees checked out under
# .claude/worktrees/ — a few hundred duplicated source files that one
# `git add .` would otherwise commit into the tree they were cut from.
.claude/

# Logs
*.log
logs/

# Browser-test runtime artifacts (reviewed evidence under docs/ is committed).
web/test-results/
web/playwright-report/

# Feast registry is derived by `feast apply` / the materializer.
src/features/feast_repo/data/registry.db

# Docker
*.override.yml

# Load-gate evidence: regenerated per run, uploaded as a CI artifact.
/artifacts/

# The deployed-release record deploy.sh keeps in the host's checkout. It is
# per-host state, not source: committing it would make one box's rollback
# target everyone's, and `git status` in /opt/movielens has to stay clean or
# the workflow's `git checkout --detach` starts refusing.
/.release/
