{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e/browser-auth.spec.ts tests/e2e/seen-journey.spec.ts tests/e2e/discover-journey.spec.ts tests/e2e/featured-skip-journey.spec.ts tests/e2e/finish-gate-journey.spec.ts tests/e2e/shell-and-doors.spec.ts tests/e2e/persona-hygiene.spec.ts",
    "test:e2e:ui": "playwright test --config playwright.ui.config.ts",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "evidence:baseline": "playwright test tests/e2e/capture-baseline.spec.ts",
    "diagrams": "node scripts/render-diagrams.mjs",
    "api:types": "openapi-typescript ../docs/api/openapi.json -o lib/api.generated.ts",
    "api:types:check": "node scripts/check-api-types.mjs",
    "test:watch": "vitest",
    "test:e2e:update": "playwright test --update-snapshots",
    "evidence:bundle4": "node scripts/capture-bundle4-evidence.mjs",
    "evidence:bundle5b": "node scripts/capture-bundle5b-evidence.mjs",
    "evidence:bundle5c": "node scripts/capture-bundle5c-evidence.mjs",
    "evidence:bundle5d": "node scripts/capture-bundle5d-evidence.mjs",
    "evidence:bundle6": "node scripts/capture-bundle6-evidence.mjs",
    "evidence:bundle7c": "node scripts/capture-bundle7c-evidence.mjs",
    "evidence:bundle7a": "node scripts/capture-bundle7a-evidence.mjs",
    "evidence:bundle7d": "node scripts/capture-bundle7d-evidence.mjs",
    "evidence:sweep": "node scripts/capture-sweep-evidence.mjs",
    "evidence:current": "node scripts/capture-current-evidence.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.11.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "mermaid": "11.17.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4"
  }
}
