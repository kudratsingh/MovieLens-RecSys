%% No offline metric values are drawn here; the measured numbers are in docs/results.md.
flowchart TB
  ML["MovieLens 25M<br/>25,000,095 ratings · 162,541 users<br/>59,047 rated movies · 0.2605% dense"]
  ING["src/data/ingest.py<br/>Postgres is the source of truth<br/>the dataset is DVC-tracked"]
  ML --> ING

  SPL["Temporal split — src/data/split.py, ADR 0001<br/>T = 80th-percentile timestamp = 2016-06-25<br/>train t &lt; T, exactly 80.00% of rows<br/>holdout [T, T+28d) — 129,683 rows over 2,641 users<br/>test t &gt;= T+28d · ties go to the later slice"]
  ING --> SPL

  FI["Point-in-time FeatureIndex<br/>user, item and user-by-item features"]
  FST[("feature_store —<br/>user_features<br/>item_features<br/>user_item_features<br/>in Postgres, the Feast offline source")]
  SPL --> FI --> FST

  subgraph CAND["Candidate stage — scored on recall@500"]
    direction TB
    C1["popularity baseline"]
    C2["CF / ALS"]
    C3["item-item cosine, k=200<br/>the demo fixture's generator"]
    C4["two-tower + FAISS<br/>measured, not promoted"]
    C5["SASRec encoder + exact FAISS<br/>gated, loadable by the sidecar<br/>measured, not promoted"]
  end

  RANK["LightGBM LambdaRank<br/>scored on NDCG@10<br/>8 ordered features from src/feature_contract.py"]
  SPL --> CAND
  FST --> RANK
  CAND --> RANK

  MLF["MLflow experiments<br/>phase-1-baselines<br/>phase-2-candidates<br/>phase-2-ranker"]
  CAND -.-> MLF
  RANK -.-> MLF

  PKG["src/training/demo_artifacts.py<br/>trains and packages the demo fixture"]
  C3 --> PKG
  RANK --> PKG

  PUB["src/models/bundle_publisher.py<br/>assembles a full-data bundle<br/>from an owner-approved spec, trains nothing"]
  C5 --> PUB
  RANK --> PUB

  MAN["ServingManifest — src/models/artifacts.py, schema 2<br/>a retriever family, one LightGBM booster per route,<br/>tenant_id, ordered feature contract, lineage, SHA-256 per artifact<br/>the demo fixture is schema 1, normalised on load:<br/>item-item-cosine / demo-itemitem-v1 · demo-lgbm-v1 · feast-phase3-v1"]
  PKG --> MAN
  PUB --> MAN

  COMMIT["Two bundles at distinct paths<br/>infra/model-bundle/ — the demo fixture<br/>infra/model-bundle-served/ — the served bundle,<br/>a placeholder until one is published"]
  MAN --> COMMIT

  IMG["Both baked into the features image at build<br/>MODEL_ARTIFACT_DIR picks one: demo the fixture,<br/>production the served path · feast apply at build<br/>CI's serving-artifacts job rebuilds and diffs the fixture"]
  COMMIT --> IMG

  GHCR["GHCR — linux/amd64<br/>tagged with the commit SHA<br/>rolling back the model is rolling back the image"]
  IMG --> GHCR

  MATZ["materialize job<br/>publishes tenant-keyed snapshots"]
  RDS[("Redis — Feast online store")]
  FST --> MATZ --> RDS

  SERVE["model-server loads the bundle once at startup,<br/>verifies every SHA-256, warms through a real rank,<br/>and refuses traffic until it is warm —<br/>or refuses to boot when the directory has no manifest"]
  GHCR --> SERVE
  RDS --> SERVE

  PAR["Feature parity in CI — tests/feature_parity/<br/>the offline value and the online value<br/>must match for the same key"]
  FST -.-> PAR
  RDS -.-> PAR
