# Production environment contract, in the form docker-compose.prod.yml reads.
#
# On the box:
#
#   cp infra/deploy/production.env.example /opt/movielens/.env.prod
#   chmod 0600 /opt/movielens/.env.prod
#   # replace every REPLACE_ME__ value and both hostnames, then deploy
#
# On a laptop, for the local rehearsal, the same copy into ./.env.prod with the
# overrides in the "Public identity" section below.
#
# `.env.prod` is ignored by git (.gitignore blocks `.env.*`). This template is
# `production.env.example` and not `.env.prod.example` on purpose: `.env.*` and
# `*.env` would both swallow the latter, and a variable contract nobody can see
# is a variable contract nobody maintains.
#
# This file is the whole contract. Every variable docker-compose.prod.yml reads
# is either here or defaulted in the compose file itself, and a unit test
# (tests/unit/test_prod_compose.py) asserts both directions -- a variable the
# compose file needs and this file forgot, and a variable this file documents
# that nothing reads any more.
#
# ---------------------------------------------------------------------------
# GENERATION RULE -- load-bearing, not a style preference.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every DSN in src/config.py is built by f-string concatenation with no
# URL-encoding, so a password containing `@` silently mis-parses the host and a
# `%` is percent-decoded. pgBouncer's userlist.txt is one `"user" "password"`
# pair per line, so a quote, space or tab in a password produces a file that
# parses as something other than what was meant -- and presents as a wrong
# password rather than a malformed file. token_urlsafe's alphabet
# (A-Z a-z 0-9 - _) removes both classes of failure.
#
# Do NOT use `openssl rand -base64`: it emits `+`, `/` and `=`.
#
# Generate a DIFFERENT value for every REPLACE_ME__ below. Reusing one across
# two roles means one leak is two compromises, and it makes rotation a
# coordinated outage instead of an ALTER ROLE.
# ---------------------------------------------------------------------------


# --- Public identity -------------------------------------------------------
# The two hostnames, and the only two things in the topology that ever get a
# domain. Everything else is private and stays private.
#
# Both must have an A record pointing at the box before the first deploy: the
# edge asks Let's Encrypt for certificates on these names, and an HTTP-01
# challenge that cannot be reached fails the issuance rather than falling back
# to anything. They are also the identity the system is built on -- the issuer
# is baked into every token and into both clients' redirect URIs -- so changing
# one after the fact means re-provisioning the realm, not editing a variable.
#
# The public origins are derived: https://<host>, nothing else. That is why
# these are hostnames and not URLs. One value, one place to change it, and no
# way for an origin and a certificate to end up describing different names.
PUBLIC_APP_HOST=app.example.com
PUBLIC_AUTH_HOST=auth.example.com

# `acme` for a public deployment, `internal` for a laptop.
#
# Under `acme` the edge gets publicly-trusted certificates for the two hosts
# above and registers the ACME account against ACME_EMAIL -- which is where
# expiry warnings go, so it should be an address somebody reads.
#
# Under `internal` the edge issues them from its own CA, which is what makes an
# https rehearsal possible with no DNS record and no reachable certificate
# authority. app.localtest.me and auth.localtest.me both resolve to 127.0.0.1
# with no DNS server and no /etc/hosts entry, which is why they are the
# rehearsal's hostnames. The whole local override is three lines:
#
#   PUBLIC_APP_HOST=app.localtest.me
#   PUBLIC_AUTH_HOST=auth.localtest.me
#   EDGE_TLS=internal
EDGE_TLS=acme
ACME_EMAIL=ops@example.com

# The realm the product is served from, and therefore the tenant. `default`
# also exists, and exists so the tenant-isolation canary has somewhere to
# authenticate from that must be refused.
SERVING_REALM=demo


# --- Images ----------------------------------------------------------------
# What the box runs. CI publishes every image to GHCR on a merge to main under
# both the 40-character commit SHA and a moving `main` tag, and a deploy pulls
# the SHA: infra/deploy/deploy.sh exports IMAGE_TAG=<sha> for the whole
# sequence, so a rollback is `docker compose pull` at a different tag and
# nothing else. The tag below is only what an operator gets by hand.
#
# The compose file keeps its `build:` sections, which is what lets a laptop
# rehearse the same file by building the same images locally -- `make up-prod`
# passes --build. The box never builds: it has neither the RAM to build the web
# image nor any reason to produce an artifact CI has not tested.
IMAGE_REPOSITORY=ghcr.io/kudratsingh/movielens-recsys
IMAGE_TAG=main

# --- Sizing ----------------------------------------------------------------
# Tuned for one Hetzner CX22: 2 vCPU, 4 GB, 40 GB. The per-service memory
# ceilings live in docker-compose.prod.yml, next to the services they bound and
# the reasoning for each; these three are the ones worth changing from a
# variable panel when the box changes.
#
# Two API workers and two model-server workers, because there are two cores.
# Four of each on two cores would trade queueing delay for context switches
# between them; the p99 the SLO is written against is measured in CI, at CI's
# shape, and these are the box's.
API_WORKERS=2
MODEL_SERVER_WORKERS=2

# Keycloak's heap, explicit rather than a percentage of the container limit.
# 512m inside a 768m limit leaves room for metaspace, code cache and thread
# stacks -- the parts that live outside the heap and are what the kernel kills
# the JVM over.
JAVA_OPTS_KC_HEAP=-Xms128m -Xmx512m

# --- Compose-only: host ports and image pins -------------------------------
# COMPOSE ONLY. The edge is the single host-published service in the stack; the
# data stores and the API deliberately publish nothing. On a single box a
# published port is a port on the public internet, so this is the first line of
# defence and ufw (infra/host/bootstrap.sh) is the second.
#
# 80 and 443 are not really adjustable: the public origins above carry no port,
# Keycloak's issuer and Auth.js's callback URL are built from them, and a
# mismatch 401s every request with no partial failure mode. They are variables
# so that a laptop with something already on 80 can still bring the stack up
# far enough to look at it.
PROD_EDGE_HTTP_PORT=80
PROD_EDGE_HTTPS_PORT=443

# COMPOSE ONLY. Kept in step with infra/ci/k6-version; ADR 0010 makes this
# version the thing that stops local and CI measurements drifting apart.
K6_VERSION=2.1.0


# --- Postgres roles --------------------------------------------------------
# Four identities, deliberately distinct. `recsys` is the superuser and is used
# by exactly one job (the one-time role provisioning); `migrator` owns the
# schema and runs Alembic; `admin_user` has BYPASSRLS for cross-tenant feature
# materialization; `app_user` has none and is the only role a request handler
# ever connects as.
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME__postgres_superuser
MIGRATOR_DB_PASSWORD=REPLACE_ME__migrator
ADMIN_USER_DB_PASSWORD=REPLACE_ME__admin_user
APP_USER_DB_PASSWORD=REPLACE_ME__app_user

# Keycloak's own database. Separate server, separate lifecycle, separate backup
# cadence -- merging the two to save a container is rejected in ADR 0013.
KC_DB_PASSWORD=REPLACE_ME__keycloak_db


# --- pgBouncer -------------------------------------------------------------
# The admin console credential. The API opens the `pgbouncer` pseudo-database
# with it at boot and refuses to start unless SHOW POOLS and SHOW CONFIG both
# report transaction mode, so this is a hard runtime dependency and not an
# operator convenience. Settings() refuses the dev default outside dev, which
# is why this cannot be left as it ships.
PGBOUNCER_ADMIN_PASSWORD=REPLACE_ME__pgbouncer_admin

# The lookup role for auth_query mode. It can execute one SECURITY DEFINER
# function and nothing else. Still generated, and still provisioned, because
# the mode below is a variable away.
PGBOUNCER_AUTH_PASSWORD=REPLACE_ME__pgbouncer_auth

# R-7 settled this and the answer is `userlist`.
#
# auth_query was the preferred mode -- only the lookup role's own password
# reaches disk, and rotating an application password would be an ALTER ROLE
# plus a variable change. It cannot be used here. The lookup returns a stored
# SCRAM *verifier*, which is enough to check a client's proof but is not a
# password, and both [databases] entries pin a forced user (user=app_user,
# user=admin_user), so pgBouncer has to open the server connection under its
# own steam rather than passing the client's exchange through. It has nothing
# to present, and the rehearsal saw exactly that:
#
#   pgbouncer: WARNING server login failed: FATAL password authentication
#              failed for user "app_user"
#
# -- the client leg succeeded and the *server* leg failed, so every connection
# through both aliases was refused and the release job died on its first query.
# userlist keeps the two passwords in a 0600 file rendered at container start
# from the environment, never in an image layer and never in the repository,
# and it authenticates in both directions. Measured 2026-08-27 against
# pgbouncer 1.24 and Postgres 16.
PGBOUNCER_AUTH_MODE=userlist


# --- Redis -----------------------------------------------------------------
# Redis is the sole online feature store, not a cache. The stack starts it with
# --maxmemory-policy noeviction because the feature views declare 3650-day TTLs
# and a missing feature reads back as 0.0 rather than raising -- an eviction
# would silently degrade every ranking score with no failure anywhere.
REDIS_PASSWORD=REPLACE_ME__redis


# --- Model sidecar ---------------------------------------------------------
# Compared with secrets.compare_digest over the whole header. Rotating it has a
# mismatch window in which the API degrades to the popularity fallback at HTTP
# 200 rather than erroring, so rotate it in a window and let `verify` confirm
# the recovery.
MODEL_SERVER_AUTH_TOKEN=REPLACE_ME__model_server_token


# --- Release ---------------------------------------------------------------
# Nothing to set. The Alembic head the model-server's pre-deploy fence waits
# for used to be stated here, because that fence runs in the features image and
# that image shipped no Alembic. It ships one now (infra/features/Dockerfile
# copies alembic.ini + alembic/), so the fence reads the head out of the image
# it is running in and a database carrying a revision the image has never heard
# of is recognised as ahead -- which is what makes a rollback's pre-deploy pass
# immediately instead of waiting out its 300 s. A hand-maintained literal here
# would only ever be as correct as the last person to remember it.


# --- Keycloak accounts and clients -----------------------------------------
# The bootstrap admin. Used once, by the keycloak-provision job, and then --
# in a real deployment -- both variables are deleted and the account is
# disabled. The rehearsal keeps them because every reset starts from empty
# volumes.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME__keycloak_bootstrap_admin

# The named human admin the provisioning job creates, which is what survives
# the bootstrap account's deletion -- and what the post-deploy realm-invariant
# check authenticates as.
KC_HUMAN_ADMIN_USERNAME=recsys-admin
KC_HUMAN_ADMIN_PASSWORD=REPLACE_ME__keycloak_human_admin

# movielens-api's client secret. Inert in production -- no grant type can use
# it -- but a confidential client must carry one, and the same value lands on
# the client in both realms.
KC_API_CLIENT_SECRET=REPLACE_ME__movielens_api_client

# movielens-verify: the confidential client every automated post-deploy check
# authenticates through, in both realms. It is deliberately NOT the API's
# KEYCLOAK_SERVICE_CLIENT_ID, so a verify token gets no azp bypass on the
# persona guard and the isolation canary proves something.
VERIFY_CLIENT_SECRET=REPLACE_ME__movielens_verify_client

# The three deliberately-created realm accounts. `walkthrough` is the human
# demo account; `verify` drives the smoke, write-path and load canaries in the
# serving realm; `isolation` lives in the `default` realm and holds neither
# demo-impersonator nor a trusted azp, which is the whole point of it.
WALKTHROUGH_PASSWORD=REPLACE_ME__walkthrough_account
VERIFY_PASSWORD=REPLACE_ME__verify_account
ISOLATION_PASSWORD=REPLACE_ME__isolation_account


# --- Post-deploy verification ----------------------------------------------
# The verify job's remaining contract. Compose fills these from the service
# names (see `verify` in docker-compose.prod.yml), so they are documented here
# rather than set -- what follows is what each one is for, because the way they
# fail is a row that reports it could not run rather than a job that crashes:
#
#   API_URL / WEB_URL / KEYCLOAK_URL  the private addresses of api, web and
#                                     keycloak
#   MODEL_SERVER_URL                  the sidecar's private address, e.g.
#                                     http://model-server:6570. The
#                                     artifact-provenance row reads the
#                                     sidecar's /healthz through it and its
#                                     default is localhost, so an unset value
#                                     fails that row against the job's own
#                                     loopback
#   APP_ORIGIN                        = https://PUBLIC_APP_HOST above. The
#                                     realm-invariant row cannot know which
#                                     redirect URIs are the expected ones
#                                     without it
#   ISOLATION_REALM / ISOLATION_USERNAME
#                                     `default` / `isolation`, the tenant-A
#                                     actor of the cross-tenant canary. Its
#                                     password is ISOLATION_PASSWORD above, and
#                                     the row fails rather than skips without it
#
# The admin-read identity for the realm-invariant row. It cannot be the verify
# client: movielens-verify has no service account and no realm-management role,
# deliberately, so that a leaked verify credential is not an admin credential.
# Two accepted forms, and the job prefers the first when both are set:
#
#   KEYCLOAK_ADMIN_CLIENT_ID / KEYCLOAK_ADMIN_CLIENT_SECRET
#       A service-account client holding only view-realm and view-clients --
#       the least privilege that answers the row. No such client exists in
#       infra/keycloak/provision.sh yet; adding one is how this moves off the
#       human admin below.
#   KEYCLOAK_ADMIN_USERNAME / KEYCLOAK_ADMIN_PASSWORD (+ KEYCLOAK_ADMIN_REALM)
#       What the rehearsal uses today: the named human admin
#       (KC_HUMAN_ADMIN_*), through admin-cli in the master realm.
#
# Uncomment both to switch, and generate the secret with the rule at the top of
# this file:
# KEYCLOAK_ADMIN_CLIENT_ID=movielens-verify-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=REPLACE_ME__keycloak_admin_client


# --- Web -------------------------------------------------------------------
# Encrypts the session JWE that holds the API tokens *and* keys the BFF's CSRF
# double-submit hash. Leave it unset and reads keep working while every
# mutation 500s -- a misconfiguration that ships and is found by a user rather
# than by a boot failure.
AUTH_SECRET=REPLACE_ME__web_auth_secret


# --- Backups ---------------------------------------------------------------
# The age *public* key dumps are encrypted to. Not a secret; the private key is
# what must never be on the same provider as the data. Generate a keypair with
# `age-keygen -o backup-key.txt` and put the public line here.
BACKUP_AGE_RECIPIENT=age1REPLACE_ME_with_a_real_age_public_key

# rclone's remote, configured entirely through RCLONE_CONFIG_REMOTE_* the way
# rclone's env-var config works. `local` writes into the stack's own volume,
# which is what makes the restore drill rehearsable without an object store;
# production points the same variables at R2 or S3 and adds the credentials --
# because a backup on the same provider as the data is one account away from
# total loss.
#
# Only the keys the backup service forwards can be set here; Compose does not
# pass a variable to a container just because this file defines it. Those keys
# are TYPE, ACCOUNT, KEY (Backblaze B2) and TYPE, PROVIDER, ENDPOINT, REGION,
# ACCESS_KEY_ID, SECRET_ACCESS_KEY (Cloudflare R2 and any other S3). Runbook
# §10 has a filled-in recipe for each; a key outside that set needs a line in
# docker-compose.prod.yml's `backup` service before it will reach rclone.
RCLONE_CONFIG_REMOTE_TYPE=local
BACKUP_REMOTE_PATH=/backups/recsys


# ---------------------------------------------------------------------------
# Deliberately absent, and each absence is the point:
#
#   DEV_AUTH_BYPASS / DEV_BYPASS_TENANT / DEV_BYPASS_USER
#       Not "false" -- absent. Settings() refuses to construct with the bypass
#       on outside dev, and a variable that is not there cannot be flipped.
#   MOVIELENS_UI_FIXTURE_MODE
#       The frontend's fixture lockout is asserted structurally; the production
#       half of it is NODE_ENV, which comes from the committed Dockerfile.
#   TMDB_READ_ACCESS_TOKEN
#       Dead at runtime: no TMDB route exists in the API, posters come from
#       movie_catalog_metadata, and the API needs no outbound internet at all
#       except JWKS.
#   POSTGRES_* on anything but the release job
#       The superuser and migrator DSNs have exactly one consumer each.
#   ADMIN_USER_* on the API
#       The BYPASSRLS engine is gone; app_user already holds SELECT on
#       public.tenants.
# ---------------------------------------------------------------------------
