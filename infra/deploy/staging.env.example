# Staging environment contract.
#
#   cp infra/deploy/staging.env.example .env.staging
#   chmod 0600 .env.staging
#   # replace every REPLACE_ME__ value, then: make up-staging
#
# `.env.staging` is ignored by git (.gitignore blocks `.env.*`); this template
# is `staging.env.example` for the same reason its production sibling is
# `production.env.example` -- `.env.*` and `*.env` would both swallow a
# `.env.staging.example`, and a variable contract nobody can see is a variable
# contract nobody maintains.
#
# ---------------------------------------------------------------------------
# THIS FILE DEFINES THE SAME VARIABLES AS infra/deploy/production.env.example.
#
# Staging runs docker-compose.prod.yml with docker-compose.staging.yml layered
# on top, so it reads exactly the production variable contract -- one contract,
# two sets of values. tests/unit/test_prod_compose.py asserts the two files
# carry the same names, in both directions: a variable staging forgot, and one
# it documents that production dropped.
#
# The consequence worth stating: the *reasoning* for each variable lives in
# production.env.example and is not repeated here. Read that file to learn what
# a variable is for; read this one to learn what staging sets it to and why that
# differs. Everything below whose value is identical to production's is
# identical deliberately -- staging exists to rehearse the box, and a staging
# stack tuned differently from the box rehearses a system nobody deploys.
#
# GENERATION RULE, unchanged and still load-bearing:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every DSN is f-string-concatenated with no URL encoding and pgBouncer's
# userlist is one quoted pair per line, so `@`, `%`, `/`, `+`, `=`, a quote or a
# space in a password fails as a wrong credential rather than as a bad file. Do
# NOT use `openssl rand -base64`. Generate a DIFFERENT value for every
# REPLACE_ME__ below, and never reuse a production value here: staging is the
# environment with the loosest access story, so a shared credential makes it
# production's blast radius.
# ---------------------------------------------------------------------------


# --- Public identity -------------------------------------------------------
# DIFFERS FROM PRODUCTION. Staging is not on public DNS, so the hostnames are
# `localtest.me` names -- every label under it resolves to 127.0.0.1 with no DNS
# server and no /etc/hosts entry -- and the edge issues certificates from its
# own CA rather than asking Let's Encrypt for names nobody can validate.
#
# A staging deployment that does live on a second box with real DNS sets its own
# two hostnames here and flips EDGE_TLS to `acme`; nothing else changes.
PUBLIC_APP_HOST=staging.app.localtest.me
PUBLIC_AUTH_HOST=staging.auth.localtest.me

# DIFFERS FROM PRODUCTION (`acme` there). `internal` means Caddy's own CA, whose
# root the edge republishes into the shared edge_ca volume so every container
# that verifies the edge can. To trust it in a browser or with curl:
#
#   make staging-edge-ca > /tmp/staging-root.crt
EDGE_TLS=internal

# Inert while EDGE_TLS=internal -- kept because the contract is shared, and
# because a staging box that switches to `acme` needs it to register the
# account. Point it at an address somebody reads.
ACME_EMAIL=ops@example.com

# Same as production: the realm the product is served from, and therefore the
# tenant. `default` also exists, so the isolation canary has somewhere to
# authenticate from that must be refused.
SERVING_REALM=demo


# --- Images ----------------------------------------------------------------
# Same registry as production, deliberately: staging exists to rehearse the
# artifact the box will run, and an image built somewhere else is not that
# artifact. Pin IMAGE_TAG to the 40-character commit SHA you are about to
# release to check a specific release before it ships; `main` is the moving tag
# and is what you get by hand.
#
# `make up-staging` builds the images locally from this checkout instead, the
# same way `make up-prod` does -- that is the mode with no registry in it.
IMAGE_REPOSITORY=ghcr.io/kudratsingh/movielens-recsys
IMAGE_TAG=main


# --- Sizing ----------------------------------------------------------------
# Same as production, and that is the point: worker counts and heap sizes are
# where a rehearsal most easily stops rehearsing anything. If the staging host
# is smaller than a CX22, change these knowingly and record that the latency and
# memory behaviour you observe is no longer the box's.
API_WORKERS=2
MODEL_SERVER_WORKERS=2
JAVA_OPTS_KC_HEAP=-Xms128m -Xmx512m


# --- Compose-only: host ports and image pins -------------------------------
# COMPOSE ONLY, and the same 80/443 production binds. They are variables rather
# than literals, but they are not really adjustable: the public origins above
# carry no port, and Keycloak's issuer and Auth.js's callback URL are built from
# them, so an edge on 8443 serves a stack whose OIDC round trip goes to 443 and
# finds nothing.
#
# The consequence on one machine: staging and the production rehearsal both want
# these ports, so run one at a time (`make staging-down` / `make prod-down`). On
# a second box the question does not arise.
PROD_EDGE_HTTP_PORT=80
PROD_EDGE_HTTPS_PORT=443

# COMPOSE ONLY. Kept in step with infra/ci/k6-version.
K6_VERSION=2.1.0


# --- Postgres roles --------------------------------------------------------
# The same four identities, and they must be four different generated values
# here just as they are in production -- staging is where a rehearsal proves the
# provisioning SQL, the pooler's forced-user aliases and RLS all still agree,
# and sharing one password across the four proves none of it.
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME__staging_postgres_superuser
MIGRATOR_DB_PASSWORD=REPLACE_ME__staging_migrator
ADMIN_USER_DB_PASSWORD=REPLACE_ME__staging_admin_user
APP_USER_DB_PASSWORD=REPLACE_ME__staging_app_user

KC_DB_PASSWORD=REPLACE_ME__staging_keycloak_db


# --- pgBouncer -------------------------------------------------------------
# Settings() refuses the dev default for PGBOUNCER_ADMIN_PASSWORD anywhere but
# dev, and ENVIRONMENT=staging is not dev -- so this cannot be left as it ships
# here either. That refusal firing in staging rather than on the box is one of
# the things staging is for.
PGBOUNCER_ADMIN_PASSWORD=REPLACE_ME__staging_pgbouncer_admin
PGBOUNCER_AUTH_PASSWORD=REPLACE_ME__staging_pgbouncer_auth

# Same as production, and for the measured reason recorded there: with
# forced-user aliases, `auth_query` hands the pooler a SCRAM verifier it cannot
# replay as a password and the *server* leg of every connection fails. If you
# ever want to re-test that finding, staging is where to do it.
PGBOUNCER_AUTH_MODE=userlist


# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=REPLACE_ME__staging_redis


# --- Model sidecar ---------------------------------------------------------
# Must differ from production's. A token mismatch degrades every recommendation
# to the popularity fallback at HTTP 200 rather than erroring, which is exactly
# the failure a rehearsal should be able to produce on purpose and never inherit
# by accident.
MODEL_SERVER_AUTH_TOKEN=REPLACE_ME__staging_model_server_token


# --- Keycloak accounts and clients -----------------------------------------
# The bootstrap admin, used once by the keycloak-provision job. Production
# deletes both variables afterwards and disables the account; staging keeps them
# because every `make staging-reset` starts from empty volumes.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME__staging_keycloak_bootstrap_admin

KC_HUMAN_ADMIN_USERNAME=recsys-admin
KC_HUMAN_ADMIN_PASSWORD=REPLACE_ME__staging_keycloak_human_admin

KC_API_CLIENT_SECRET=REPLACE_ME__staging_movielens_api_client
VERIFY_CLIENT_SECRET=REPLACE_ME__staging_movielens_verify_client

WALKTHROUGH_PASSWORD=REPLACE_ME__staging_walkthrough_account
VERIFY_PASSWORD=REPLACE_ME__staging_verify_account
ISOLATION_PASSWORD=REPLACE_ME__staging_isolation_account


# --- Web -------------------------------------------------------------------
AUTH_SECRET=REPLACE_ME__staging_web_auth_secret


# --- Backups ---------------------------------------------------------------
# `local` writes into the staging project's own volume. Staging deliberately has
# no scheduled backup and no off-box remote: there is no `staging-backup`
# Makefile target, so the job only runs when an operator asks for it by hand,
# and pointing staging at production's bucket would put throwaway dumps in the
# place the real recovery story lives.
#
# The age recipient is a public key and is not a secret. Reuse production's or
# generate a throwaway pair with `age-keygen`; either way the private half must
# not live on the same provider as the data.
BACKUP_AGE_RECIPIENT=age1REPLACE_ME_with_a_real_age_public_key
RCLONE_CONFIG_REMOTE_TYPE=local
BACKUP_REMOTE_PATH=/backups/recsys


# ---------------------------------------------------------------------------
# Deliberately absent here for exactly the reasons production.env.example gives,
# and one more that is specific to staging:
#
#   DEV_AUTH_BYPASS / DEV_BYPASS_TENANT / DEV_BYPASS_USER
#       Not "false" -- absent. Settings() refuses to construct with the bypass
#       on outside dev, and `staging` is not dev. If you want the bypass, you
#       want the dev stack (`make up-dev`), which is a different topology and
#       says so.
#   MOVIELENS_UI_FIXTURE_MODE
#   TMDB_READ_ACCESS_TOKEN
#   POSTGRES_* on anything but the release job
#   ADMIN_USER_* on the API
# ---------------------------------------------------------------------------
