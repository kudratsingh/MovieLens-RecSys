{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/api/Dockerfile",
    "watchPatterns": [
      "src/**",
      "alembic/**",
      "alembic.ini",
      "synthetic/**",
      "infra/api/**"
    ]
  },
  "deploy": {
    "startCommand": "uvicorn src.serving.app:app --host 0.0.0.0 --port 8000 --workers 4 --no-access-log",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 20,
    "drainingSeconds": 15
  }
}
