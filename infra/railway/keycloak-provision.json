{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/keycloak/Dockerfile",
    "watchPatterns": [
      "infra/keycloak/**"
    ]
  },
  "deploy": {
    "startCommand": "/opt/keycloak/provision.sh",
    "restartPolicyType": "NEVER"
  }
}
