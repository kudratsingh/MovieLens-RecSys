{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/keycloak/Dockerfile",
    "watchPatterns": [
      "infra/keycloak/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/realms/master/.well-known/openid-configuration",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
