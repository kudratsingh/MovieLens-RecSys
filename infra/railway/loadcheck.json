{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/k6/Dockerfile",
    "watchPatterns": [
      "infra/k6/**",
      "synthetic/load/**"
    ]
  },
  "deploy": {
    "startCommand": "k6 run /scripts/recommendations.js",
    "restartPolicyType": "NEVER"
  }
}
