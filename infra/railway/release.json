{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/api/Dockerfile",
    "watchPatterns": [
      "src/**",
      "alembic/**",
      "alembic.ini",
      "synthetic/**",
      "infra/api/**"
    ]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/entrypoint.sh bootstrap all",
    "restartPolicyType": "NEVER"
  }
}
