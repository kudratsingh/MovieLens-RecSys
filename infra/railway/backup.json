{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/backup/Dockerfile",
    "watchPatterns": [
      "infra/backup/**"
    ]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/backup.sh",
    "restartPolicyType": "NEVER",
    "cronSchedule": "0 4 * * *"
  }
}
